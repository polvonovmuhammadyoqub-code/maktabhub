# MaktabZiyo Environment Configuration Example

# Backend Server Port (local development default: 5000)
PORT=5000

# Optional: Frontend API URL (if frontend and backend are hosted on different domains)
# e.g.: VITE_API_URL=https://maktabziyo-api.onrender.com
# If hosted together on Vercel or locally, leave empty.
VITE_API_URL=
